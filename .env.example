# Copy to .env in the project root. backend/main.py loads it on startup.

# IANA time zone of the campus (confirm with the campus administrator).
CAMPUS_TIME_ZONE=America/Chicago

# Signing key for login tokens. Without it a random key is used and every
# restart signs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CAMPUSRESERVE_SECRET_KEY=

# Google Gemini key for the AI Smart Finder (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
